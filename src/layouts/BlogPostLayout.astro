---
import SiteLayout from "./SiteLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { DEFAULT_LOCALE, getBasePath, getDictionary, getLangHref } from "../i18n";

const meta = Astro.props.frontmatter ?? Astro.props;
const locale = meta.locale ?? DEFAULT_LOCALE;
const dict = getDictionary(locale);
const base = getBasePath(locale);
const { title, date, description, product } = meta;

// 规范化文章路径：移除首尾多余斜杠并去除已有的 .html
const rawPath = (Astro.url?.pathname ?? "/blog/index")
  .replace(/\/+$/, "")
  .replace(/\.html$/, "");
const slugPath = rawPath.replace(/^\/cn/, "") || "/blog/index";

const enPath = `${slugPath}.html`;
const cnPath = `/cn${slugPath}.html`;

// 语言切换目标地址（严格精确到 .html，无末尾斜杠）
const langHref = locale === DEFAULT_LOCALE ? cnPath : enPath;
const canonicalUrl = `https://fineusing.com${locale === DEFAULT_LOCALE ? enPath : cnPath}`;
const altEn = `https://fineusing.com${enPath}`;
const altZh = `https://fineusing.com${cnPath}`;

const productMetaMap: Record<string, any> = {
  Rightly: {
    name: "Rightly",
    tagline: locale === "cn" ? "macOS 原生右键增强工具" : "Finder Right-Click Toolkit for macOS",
    desc: locale === "cn" ? "把常用操作放进 Finder 右键菜单，支持新建 10+ 格式文件、30+ 格式压缩解压与常用目录直达。" : "Supercharge your Finder right-click menu with instant file creation, 30+ archive formats, and quick access.",
    href: `${base}/rightly.html`,
    cta: locale === "cn" ? "App Store 下载" : "Get on Mac App Store",
    downloadUrl: "https://apps.apple.com/app/id6806805796",
    logo: "/img/rightly-logo.png"
  },
  DeviceMirror: {
    name: "DeviceMirror",
    tagline: locale === "cn" ? "iPhone / iPad 屏幕镜像到 Mac" : "iPhone Screen Mirroring to Mac",
    desc: locale === "cn" ? "超低延迟投屏，支持无线 AirPlay 与 USB 有线连接，大屏畅享游戏与观影。" : "Low-latency AirPlay & USB wired screen mirroring for iPhone and iPad to Mac.",
    href: `${base}/devicemirror.html`,
    cta: locale === "cn" ? "App Store 下载" : "Get on Mac App Store",
    downloadUrl: "https://apps.apple.com/app/id1598771178",
    logo: "/img/devicemirror-logo.png"
  },
  NTFSSync: {
    name: "NTFSSync",
    tagline: locale === "cn" ? "macOS 专业 NTFS 磁盘读写工具" : "Professional NTFS Read-Write Driver for macOS",
    desc: locale === "cn" ? "打破 Mac 移动硬盘只读限制，插盘自动以读写模式挂载，原生高速文件传输与磁盘修复抹除。" : "Mount external NTFS drives in full read-write mode automatically with native transfer speed and disk repair tools.",
    href: `${base}/ntfssync.html`,
    cta: locale === "cn" ? "App Store 下载" : "Get on Mac App Store",
    downloadUrl: "https://apps.apple.com/app/id6475194342",
    logo: "/img/ntfssync-logo.png"
  },
  AppPad: {
    name: "AppPad",
    tagline: locale === "cn" ? "macOS 极速启动台替代品" : "Lightning-Fast Launchpad Alternative",
    desc: locale === "cn" ? "Swift 原生打造，毫秒级快速启动应用，支持自定义分组与触控板手势唤出。" : "Instant app launcher built in Swift and AppKit. Custom categories, gestures, and hot corner triggers.",
    href: `${base}/apppad.html`,
    cta: locale === "cn" ? "立即下载体验" : "Download AppPad",
    downloadUrl: "https://fineusing.com/installer/AppPad-Installer.dmg",
    logo: "/img/apppad-logo.png"
  },
  ZipGo: {
    name: "ZipGo",
    tagline: locale === "cn" ? "Finder 原生右键解压缩工具" : "Finder Right-Click Archiver for macOS",
    desc: locale === "cn" ? "右键一键解压 30+ 格式，免解压极速预览压缩包，支持加密与分卷压缩。" : "Extract 30+ archive formats directly from Finder, preview without unpacking, and create encrypted archives.",
    href: `${base}/zipgo.html`,
    cta: locale === "cn" ? "App Store 下载" : "Get on Mac App Store",
    downloadUrl: "https://apps.apple.com/app/id6799313183",
    logo: "/img/zipgo-logo.png"
  }
};

const currentProduct = product ? productMetaMap[product] : null;
---
<SiteLayout lang={dict.langTag}>
  <Fragment slot="head">
    <title>{title} | Fineusing</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={`${title} | Fineusing`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="zh-Hans" href={altZh} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
  </Fragment>

  <Navbar locale={locale} langHref={langHref} />

  <article class="pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto">
      {currentProduct && (
        <div class="mb-4">
          <a
            href={currentProduct.href}
            class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-blue-600 hover:text-blue-800 transition-colors"
          >
            ← {currentProduct.name}
          </a>
        </div>
      )}
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight leading-tight">{title}</h1>
      {date && <div class="text-sm text-slate-400 mt-4">{date}</div>}
      
      <div class="mt-8 markdown">
        <slot />
      </div>

      {currentProduct && (
        <div class="mt-16 p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center gap-6">
          <img
            src={currentProduct.logo}
            alt={`${currentProduct.name} logo`}
            class="w-16 h-16 rounded-xl shadow-sm shrink-0"
            onerror="this.onerror=null; this.src='/img/apppad-logo.png';"
          />
          <div class="flex-1 text-center sm:text-left">
            <h3 class="text-lg font-bold text-slate-900">{currentProduct.name} - {currentProduct.tagline}</h3>
            <p class="text-sm text-slate-600 mt-1 leading-relaxed">{currentProduct.desc}</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-2 shrink-0 w-full sm:w-auto">
            <a
              href={currentProduct.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-sm font-semibold text-center transition-colors shadow-sm"
            >
              {currentProduct.cta}
            </a>
            <a
              href={currentProduct.href}
              class="px-4 py-2.5 bg-white border border-slate-200 hover:border-slate-400 text-slate-700 rounded-lg text-sm font-semibold text-center transition-colors"
            >
              {locale === "cn" ? "了解更多" : "Learn more"}
            </a>
          </div>
        </div>
      )}
    </div>
  </article>

  <Footer locale={locale} />
</SiteLayout>
