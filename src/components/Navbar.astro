---
import { getBasePath, getDictionary, DEFAULT_LOCALE } from "../i18n";

const { locale = DEFAULT_LOCALE, active = "", langHref = "/cn/", currentPath = "" } = Astro.props;
const dict = getDictionary(locale);
const base = getBasePath(locale);

const homeHref = `${base}/index.html`;
const apppadHref = `${base}/apppad.html`;
const devicemirrorHref = `${base}/devicemirror.html`;
const aconverterHref = `${base}/aconverter.html`;
const rightlyHref = `${base}/rightly.html`;
const zipgoHref = `${base}/zipgo.html`;
const ntfssyncHref = `${base}/ntfssync.html`;
const blogHref = `${base}/blog/index.html`;
const contactHref = `${base}/contact.html`;
const privacyHref = `${base}/privacy.html`;

const homeActive = active === "home";
const productsActive = active === "products";

// Compute page links for language switcher
const rawPage = currentPath || (langHref ? langHref.replace(/^\/(cn|ja)/, "") : "/index.html");
const cleanPage = rawPage.startsWith("/") ? rawPage : `/${rawPage}`;
const enHref = cleanPage;
const cnHref = `/cn${cleanPage}`;
const jaHref = `/ja${cleanPage}`;
---
<nav class="fixed w-full z-50 top-0 start-0 bg-white/90 backdrop-blur-md border-b border-gray-100">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href={homeHref} class="flex items-center space-x-2">
      <div class="w-8 h-8 bg-slate-900 text-white rounded-lg flex items-center justify-center font-bold">F</div>
      <span class="self-center text-xl font-bold whitespace-nowrap tracking-tight">Fineusing</span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div class="hidden w-full md:block md:w-auto" id="navbar-dropdown">
      <ul class="flex flex-col font-medium p-4 md:p-0 mt-4 border border-gray-100 rounded-lg md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 items-center">
        <li>
          <a
            href={homeHref}
            class={`block py-2 px-3 rounded md:bg-transparent md:p-0 ${
              homeActive ? "text-blue-600" : "text-gray-900 hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600"
            }`}
            aria-current={homeActive ? "page" : undefined}
          >
            {dict.nav.home}
          </a>
        </li>

        <li class="relative group">
          <button
            class={`flex items-center justify-between w-full py-2 px-3 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 md:p-0 cursor-pointer ${
              productsActive ? "text-blue-600" : "text-gray-900"
            }`}
          >
            {dict.nav.products}
            <svg class="w-2.5 h-2.5 ms-2.5" fill="none" stroke="currentColor" viewBox="0 0 10 6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4" />
            </svg>
          </button>

          <div class="dropdown-menu absolute left-1/2 top-full w-64 pt-4 z-50">
            <div class="bg-white divide-y divide-gray-100 rounded-xl shadow-xl border border-gray-100 overflow-hidden">
              <ul class="text-sm text-gray-700">
                <li>
                  <a href={rightlyHref} class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
                    <img src="/img/rightly-logo.png" onerror="this.onerror=null; this.src='/img/apppad-logo.png';" class="w-10 h-10 mr-3" alt="Rightly logo" />
                    <div>
                      <div class="font-semibold text-gray-900">Rightly</div>
                      <div class="text-xs text-gray-500">{dict.nav.rightlyTag}</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={devicemirrorHref} class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
                    <img src="/img/devicemirror-logo.png" class="w-10 h-10 mr-3" alt="DeviceMirror logo" />
                    <div>
                      <div class="font-semibold text-gray-900">DeviceMirror</div>
                      <div class="text-xs text-gray-500">{dict.nav.devicemirrorTag}</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={aconverterHref} class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
                    <img src="/img/aconverter-logo.png" onerror="this.onerror=null; this.src='/img/devicemirror-logo.png';" class="w-10 h-10 mr-3" alt="AConverter logo" />
                    <div>
                      <div class="font-semibold text-gray-900">AConverter</div>
                      <div class="text-xs text-gray-500">{dict.nav.aconverterTag}</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={ntfssyncHref} class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
                    <img src="/img/ntfssync-logo.png" onerror="this.onerror=null; this.src='/img/rightly-logo.png';" class="w-10 h-10 mr-3" alt="NTFSSync logo" />
                    <div>
                      <div class="font-semibold text-gray-900">NTFSSync</div>
                      <div class="text-xs text-gray-500">{dict.nav.ntfssyncTag}</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={apppadHref} class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
                    <img src="/img/apppad-logo.png" class="w-10 h-10 mr-3" alt="AppPad logo" />
                    <div>
                      <div class="font-semibold text-gray-900">AppPad</div>
                      <div class="text-xs text-gray-500">{dict.nav.apppadTag}</div>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={zipgoHref} class="flex items-center px-4 py-3 hover:bg-gray-50 transition-colors">
                    <img src="/img/zipgo-logo.png" onerror="this.onerror=null; this.src='/img/rightly-logo.png';" class="w-10 h-10 mr-3" alt="ZipGo logo" />
                    <div>
                      <div class="font-semibold text-gray-900">ZipGo</div>
                      <div class="text-xs text-gray-500">{dict.nav.zipgoTag}</div>
                    </div>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </li>

        <li>
          <a href={blogHref} class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 md:p-0">
            {dict.nav.blog}
          </a>
        </li>
        <li>
          <a href={contactHref} class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 md:p-0">
            {dict.nav.contact}
          </a>
        </li>
        <li>
          <a href={privacyHref} class="block py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 md:p-0">
            {dict.nav.privacy}
          </a>
        </li>

        <!-- Vertical Divider -->
        <li class="hidden md:block h-4 w-px bg-gray-200 my-auto mx-1" aria-hidden="true"></li>

        <!-- Language Switcher Dropdown -->
        <li class="relative group" id="lang-menu-item">
          <button
            id="lang-toggle-btn"
            type="button"
            class="flex items-center py-1.5 px-2 rounded-lg text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-gray-100/80 transition-colors cursor-pointer select-none"
            aria-label="Language selection"
            aria-expanded="false"
          >
            <svg class="w-4 h-4 mr-1 text-slate-400 group-hover:text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
            </svg>
            <span class="text-xs font-semibold">{locale === "ja" ? "日本語" : locale === "cn" ? "中文" : "English"}</span>
            <svg class="w-2.5 h-2.5 ms-1 text-slate-400 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 10 6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4" />
            </svg>
          </button>

          <!-- Dropdown card wrapper: pt-1.5 provides the seamless hover bridge -->
          <div class="dropdown-menu-lang absolute right-0 top-full pt-1.5 z-50" id="lang-dropdown-panel">
            <div class="bg-white divide-y divide-gray-100 rounded-xl shadow-xl border border-gray-100 py-1 w-32 text-sm overflow-hidden ring-1 ring-black/5">
              <a
                href={enHref}
                data-lang="en"
                class={`flex items-center justify-between px-3.5 py-2 transition-colors ${
                  locale === "en" ? "text-blue-600 font-semibold bg-blue-50/70" : "text-gray-700 hover:bg-gray-50"
                }`}
              >
                <span>English</span>
                {locale === "en" && (
                  <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
              <a
                href={cnHref}
                data-lang="zh"
                class={`flex items-center justify-between px-3.5 py-2 transition-colors ${
                  locale === "cn" ? "text-blue-600 font-semibold bg-blue-50/70" : "text-gray-700 hover:bg-gray-50"
                }`}
              >
                <span>简体中文</span>
                {locale === "cn" && (
                  <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
              <a
                href={jaHref}
                data-lang="ja"
                class={`flex items-center justify-between px-3.5 py-2 transition-colors ${
                  locale === "ja" ? "text-blue-600 font-semibold bg-blue-50/70" : "text-gray-700 hover:bg-gray-50"
                }`}
              >
                <span>日本語</span>
                {locale === "ja" && (
                  <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</nav>
