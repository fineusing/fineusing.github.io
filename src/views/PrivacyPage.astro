---
import SiteLayout from "../layouts/SiteLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getDictionary, getLangHref, DEFAULT_LOCALE } from "../i18n";

const { locale = DEFAULT_LOCALE, enableLangRedirect = false } = Astro.props;
const dict = getDictionary(locale);
const langHref = getLangHref(locale, "/privacy.html");

const canonical = locale === DEFAULT_LOCALE
  ? "https://fineusing.com/privacy.html"
  : `https://fineusing.com/${locale}/privacy.html`;
const altEn = "https://fineusing.com/privacy.html";
const altZh = "https://fineusing.com/cn/privacy.html";
const altJa = "https://fineusing.com/ja/privacy.html";
const altTc = "https://fineusing.com/tc/privacy.html";
const altFr = "https://fineusing.com/fr/privacy.html";
const altDe = "https://fineusing.com/de/privacy.html";
---
<SiteLayout lang={dict.langTag} enableLangRedirect={enableLangRedirect}>
  <Fragment slot="head">
    <title>
      {locale === DEFAULT_LOCALE
        ? "Fineusing: Privacy Policy"
        : locale === "ja"
        ? "Fineusing: プライバシーポリシー"
        : locale === "tc"
        ? "Fineusing: 隱私權政策"
        : locale === "fr"
        ? "Fineusing: Politique de confidentialité"
        : locale === "de"
        ? "Fineusing: Datenschutzrichtlinie"
        : "Fineusing: 隐私政策"}
    </title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="zh-Hans" href={altZh} />
    <link rel="alternate" hreflang="ja" href={altJa} />
    <link rel="alternate" hreflang="zh-Hant" href={altTc} />
    <link rel="alternate" hreflang="fr" href={altFr} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
  </Fragment>

  <Navbar locale={locale} langHref={langHref} />

  <main class="pt-32 pb-20 px-4 max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold mb-8 text-slate-900">{dict.privacy.title}</h1>
    <p class="text-slate-500 mb-8">{dict.privacy.updated}</p>
    <div class="prose prose-slate max-w-none text-slate-600 space-y-6">
      {dict.privacy.sections.map((section) => (
        <div>
          <h3 class="text-xl font-bold text-slate-800">{section.title}</h3>
          <p>{section.body}</p>
        </div>
      ))}
    </div>
  </main>

  <Footer locale={locale} />
</SiteLayout>
