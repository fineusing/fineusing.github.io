---
import SiteLayout from "../layouts/SiteLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getDictionary, getLangHref, DEFAULT_LOCALE } from "../i18n";

const { locale = DEFAULT_LOCALE, enableLangRedirect = false } = Astro.props;
const dict = getDictionary(locale);
const langHref = getLangHref(locale, "/apppad.html");

const ldJson = locale === DEFAULT_LOCALE
  ? `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AppPad",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "macOS",
        "description": "A powerful macOS Launchpad alternative with fast launching, custom grouping, and gesture support",
        "url": "https://fineusing.com/apppad.html",
        "image": "https://fineusing.com/img/apppad-home.png",
        "screenshot": "https://fineusing.com/img/apppad-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": [
            "Lightning Fast Launch",
            "Custom App Grouping",
            "Layout Compatibility",
            "Hotkey Support",
            "Trackpad Gestures",
            "Hot Corner Support"
        ],
        "author": {
            "@type": "Organization",
            "name": "Fineusing"
        }
    }`
  : `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AppPad",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "macOS",
        "description": "强大的macOS 26启动台替代品，具有快速启动、自定义分组和手势支持",
        "url": "https://fineusing.com/cn/apppad.html",
        "image": "https://fineusing.com/img/apppad-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "CNY"
        },
        "featureList": [
            "闪电般快速启动",
            "自定义应用分组",
            "布局兼容性",
            "快捷键支持",
            "触控板手势",
            "热角支持"
        ],
        "author": {
            "@type": "Organization",
            "name": "Fineusing"
        }
    }`;

const canonical = locale === DEFAULT_LOCALE ? "https://fineusing.com/apppad.html" : "https://fineusing.com/cn/apppad.html";
const ogUrl = canonical;
const altEn = "https://fineusing.com/apppad.html";
const altZh = "https://fineusing.com/cn/apppad.html";
---
<SiteLayout lang={dict.langTag} enableLangRedirect={enableLangRedirect}>
  <Fragment slot="head">
    <title>{locale === DEFAULT_LOCALE ? "AppPad: Launchpad Alternative for macOS 26 Tahoe" : "AppPad: macOS 26 Tahoe启动台替代品"}</title>
    <meta
      name="description"
      content={
        locale === DEFAULT_LOCALE
          ? "AppPad is the best Launchpad alternative for macOS 26 Tahoe with lightning-fast performance, custom app grouping, gesture support, and hot corners. Built with native Swift and AppKit."
          : "AppPad是macOS 26 Tahoe的最佳启动台替代品，具有极速性能、自定义应用分组、手势支持和热角功能。使用原生Swift和AppKit构建。"
      }
    />
    <meta
      name="keywords"
      content={
        locale === DEFAULT_LOCALE
          ? "Launchpad, AppPad, macOS 26 Tahoe Launchpad, App Launcher, application launcher, Mac app management, Swift development, AppKit, app grouping, gesture support, hot corners, Mac utility"
          : "启动台, AppPad, macOS 26 Tahoe 启动台, 应用启动器, 应用程序启动器, Mac应用管理, Swift 开发, AppKit, 应用分组, 手势支持, 热角, Mac 实用工具"
      }
    />
    <meta name="author" content="AppPad" />

    <meta
      property="og:title"
      content={locale === DEFAULT_LOCALE ? "AppPad: Best Launchpad Alternative for macOS 26 Tahoe" : "AppPad: macOS 26 Tahoe最佳启动台替代品"}
    />
    <meta
      property="og:description"
      content={
        locale === DEFAULT_LOCALE
          ? "Lightning-fast app launcher for macOS 26 Tahoe with custom grouping and gesture support"
          : "macOS 26 Tahoe的极速应用启动器，支持自定义分组和手势"
      }
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content="https://fineusing.com/img/apppad-home.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="800" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="zh-Hans" href={altZh} />
    <link rel="alternate" hreflang="x-default" href={altEn} />

    <script type="application/ld+json" set:html={ldJson}></script>
  </Fragment>

  <Navbar locale={locale} active="products" langHref={langHref} />

  <section class="pt-32 pb-16 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl font-bold mb-6">{dict.apppad.title}</h1>
      <p class="text-xl text-slate-500 mb-10">{dict.apppad.subtitle}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in-up delay-300">
        <a
          href="https://fineusing.com/installer/AppPad-Installer.dmg"
          id="download"
          class="w-full sm:w-auto px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg flex items-center justify-center gap-2"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.3-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.21-1.96 1.08-3.11-1.06.05-2.36.71-3.13 1.61-.65.77-1.22 2.01-1.07 3.11 1.2.09 2.4-.62 3.12-1.61"
            ></path>
          </svg>
          {dict.apppad.cta}
        </a>
      </div>
    </div>
    <div class="mt-20 max-w-5xl mx-auto rounded-2xl border border-gray-200 bg-gray-50 p-4 mac-shadow">
      <img src="/img/apppad-home.png" alt="AppPad home" />
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
      {dict.apppad.features.map((feature) => (
        <div class="bg-white p-8 rounded-2xl shadow-sm">
          <h3 class="text-xl font-bold mb-2">{feature.title}</h3>
          <p class="text-slate-500">{feature.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="showcase" class="py-20 overflow-hidden">
    <div class="max-w-screen-xl mx-auto px-4">
      <div class="flex flex-col md:flex-row items-center gap-12 mb-20">
        <div class="w-full md:w-1/2">
          <div
            class="rounded-xl bg-gray-100 aspect-video flex items-center justify-center border border-gray-200 shadow-lg transform -rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img src="/img/apppad-group.png" alt="AppPad grouping" />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-bold mb-4 text-slate-900">{dict.apppad.showcase[0].title}</h3>
          <p class="text-lg text-slate-500 mb-6">{dict.apppad.showcase[0].body}</p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row-reverse items-center gap-12">
        <div class="w-full md:w-1/2">
          <div
            class="rounded-xl bg-gray-100 aspect-video flex items-center justify-center border border-gray-200 shadow-lg transform rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img src="/img/apppad-setting.png" alt="AppPad settings" />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-bold mb-4 text-slate-900">{dict.apppad.showcase[1].title}</h3>
          <p class="text-lg text-slate-500">{dict.apppad.showcase[1].body}</p>
        </div>
      </div>
    </div>
  </section>

  <Footer locale={locale} />
</SiteLayout>
