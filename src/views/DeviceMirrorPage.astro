---
import SiteLayout from "../layouts/SiteLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getDictionary, getLangHref, DEFAULT_LOCALE } from "../i18n";

const { locale = DEFAULT_LOCALE, enableLangRedirect = false } = Astro.props;
const dict = getDictionary(locale);
const langHref = getLangHref(locale, "/devicemirror.html");

const ldJson = locale === DEFAULT_LOCALE
  ? `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "DeviceMirror",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS",
        "description": "Dual-mode USB & Wi-Fi AirPlay iOS screen and audio mirroring for Mac with 4K resolution, multi-device support, and MP4/GIF recording",
        "url": "https://fineusing.com/devicemirror.html",
        "image": "https://fineusing.com/img/devicemirror-home.png",
        "screenshot": "https://fineusing.com/img/devicemirror-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": [
            "USB 4K & Wi-Fi 2.5K Dual-Mode Mirroring",
            "Simultaneous Multi-Device Screen Mirroring",
            "Zero App Installation on iOS (Native AirPlay)",
            "Screen Recording to MP4, MOV, and GIF",
            "Real-Time High-Resolution Screenshots (PNG/JPEG)",
            "Cast from 200+ Online Video Platforms",
            "Lossless System Audio Sync & Speaker Playback"
        ],
        "permissions": "No app installation required on iOS devices"
    }`
  : locale === "ja"
  ? `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "DeviceMirror",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS",
        "description": "iPhone/iPadの画面と音声をMacにUSB有線（4K）およびWi-Fi（2.5K）で超低遅延ミラーリングするアプリ。複数台同時表示、MP4/MOV/GIF録画、200+動画サイト対応。",
        "url": "https://fineusing.com/ja/devicemirror.html",
        "image": "https://fineusing.com/img/devicemirror-home.png",
        "screenshot": "https://fineusing.com/img/devicemirror-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "JPY"
        },
        "featureList": [
            "USB有線（最大4K）＆Wi-Fi（最大2.5K）双モード投映",
            "複数デバイスの同時画面ミラーリング",
            "iOS側アプリ不要（標準AirPlay対応）",
            "MP4・MOV・GIF形式での画面録画",
            "リアルタイム高画質スクリーンショット（PNG/JPEG）",
            "200以上の動画配信サイトからの大画面キャスト",
            "システム音声の同期とMacスピーカー再生"
        ],
        "author": {
            "@type": "Organization",
            "name": "Fineusing"
        }
    }`
  : `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "DeviceMirror",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS",
        "description": "USB有线与Wi-Fi双模投屏：将iOS设备屏幕与声音超清镜像到Mac，支持多设备并发、4K画质、MP4/GIF录制与200+视频平台大屏播放。",
        "url": "https://fineusing.com/cn/devicemirror.html",
        "image": "https://fineusing.com/img/devicemirror-home.png",
        "screenshot": "https://fineusing.com/img/devicemirror-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "CNY"
        },
        "featureList": [
            "USB有线（最高4K）与Wi-Fi（最高2.5K）双模投屏",
            "支持多台iPhone/iPad同时并发镜像",
            "免在iOS设备安装App（原生AirPlay协议）",
            "投屏画面录制为 MP4 / MOV / GIF",
            "实时截图保存为 PNG 与 JPEG 格式",
            "支持腾讯、爱奇艺、YouTube等200+视频网站大屏投射",
            "iOS系统音频无损同步与Mac扬声器监听"
        ],
        "author": {
            "@type": "Organization",
            "name": "Fineusing"
        }
    }`;

const canonical = locale === DEFAULT_LOCALE
  ? "https://fineusing.com/devicemirror.html"
  : locale === "ja"
  ? "https://fineusing.com/ja/devicemirror.html"
  : "https://fineusing.com/cn/devicemirror.html";
const ogUrl = canonical;
const altEn = "https://fineusing.com/devicemirror.html";
const altZh = "https://fineusing.com/cn/devicemirror.html";
const altJa = "https://fineusing.com/ja/devicemirror.html";
---
<SiteLayout lang={dict.langTag} enableLangRedirect={enableLangRedirect}>
  <Fragment slot="head">
    <title>
      {locale === DEFAULT_LOCALE
        ? "DeviceMirror: iPhone Mirror for Mac | USB 4K & Wi-Fi AirPlay Screen Mirroring"
        : locale === "ja"
        ? "DeviceMirror: iPhone画面をMacにミラーリング | USB 4K＆Wi-Fi AirPlay対応"
        : "DeviceMirror: iPhone/iPad投屏到Mac | USB 4K与Wi-Fi双模镜像录制"}
    </title>
    <meta
      name="title"
      content={
        locale === DEFAULT_LOCALE
          ? "DeviceMirror - Dual-Mode USB & Wi-Fi iOS Screen Mirroring for Mac"
          : locale === "ja"
          ? "DeviceMirror - iPhone/iPad画面をMacに超低遅延ミラーリング＆録画"
          : "DeviceMirror - USB 4K与Wi-Fi双模：iPhone/iPad屏幕声音镜像到Mac"
      }
    />
    <meta
      name="description"
      content={
        locale === DEFAULT_LOCALE
          ? "Best iPhone mirror app for Mac. Mirror iOS screen and audio to Mac via USB (up to 4K) or Wi-Fi (up to 2.5K). Support multi-device mirroring, MP4/MOV/GIF recording, and 200+ video sites."
          : locale === "ja"
          ? "iPhoneやiPadの画面と音声をMacに超低遅延ミラーリング。USB有線（最大4K）＆Wi-Fi（最大2.5K）対応、複数台同時表示、MP4/MOV/GIF録画、200以上の動画配信サイトの大画面再生をサポート。"
          : "专业Mac版iPhone/iPad投屏软件。支持USB有线（最高4K）与Wi-Fi（最高2.5K）双模投屏、多台设备同时镜像、音画同录为MP4/MOV/GIF、实时PNG/JPEG截图以及200+主流视频网站大屏投射。"
      }
    />
    <meta
      name="keywords"
      content={
        locale === DEFAULT_LOCALE
          ? "DeviceMirror, iPhone mirror for Mac, screen mirroring iPhone to Mac, AirPlay Mac, 4K screen mirroring, mirror iPad to Mac, record iPhone screen on Mac, multi-device mirroring, iOS screen recording GIF"
          : locale === "ja"
          ? "DeviceMirror, iPhone ミラーリング Mac, iPhone 画面共有 Mac, AirPlay ミラーリング Mac, iPad ミラーリング, スマホ画面 Mac 録画, 4K ミラーリング, 複数台 同時 ミラーリング, スマホ 画面録画 GIF"
          : "DeviceMirror, iPhone投屏Mac, iPad投屏Mac, Mac接收AirPlay, USB投屏4K, 手机投屏录制GIF, 苹果手机镜像到电脑, 多台iPhone同时投屏, 腾讯视频投屏Mac, 爱奇艺投屏Mac"
      }
    />
    <meta name="author" content="Fineusing" />
    <meta name="robots" content="index, follow" />

    <meta
      property="og:title"
      content={
        locale === DEFAULT_LOCALE
          ? "DeviceMirror - AirPlay Screen Mirroring for iPhone/iPad to Mac"
          : locale === "ja"
          ? "DeviceMirror: iPhone画面をMacにミラーリング | AirPlay 画面ミラーリング"
          : "DeviceMirror - iPhone/iPad 到 Mac 的 AirPlay 屏幕镜像"
      }
    />
    <meta
      property="og:description"
      content={
        locale === DEFAULT_LOCALE
          ? "Mirror your iPhone and iPad screens to Mac with DeviceMirror"
          : locale === "ja"
          ? "iPhone/iPad の画面を Mac の大画面に超低遅延でミラーリング。ゲーム実況や動画視聴に最適。"
          : "使用 DeviceMirror 将您的 iPhone 和 iPad 屏幕镜像到 Mac"
      }
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content="https://fineusing.com/img/devicemirror-home.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="800" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="zh-Hans" href={altZh} />
    <link rel="alternate" hreflang="ja" href={altJa} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEn} />

    <script type="application/ld+json" set:html={ldJson}></script>
  </Fragment>

  <Navbar locale={locale} active="products" langHref={langHref} />

  <section class="pt-32 pb-16 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl font-bold mb-6">{dict.devicemirror.title}</h1>
      <p class="text-xl text-slate-500 mb-10">{dict.devicemirror.subtitle}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in-up delay-300">
        <a
          href={dict.devicemirror.downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="download"
          class="w-full sm:w-auto px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg flex items-center justify-center gap-2"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.3-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.21-1.96 1.08-3.11-1.06.05-2.36.71-3.13 1.61-.65.77-1.22 2.01-1.07 3.11 1.2.09 2.4-.62 3.12-1.61"
            ></path>
          </svg>
          {dict.devicemirror.cta}
        </a>
      </div>
    </div>
    <div class="mt-20 max-w-5xl mx-auto rounded-2xl border border-gray-200 bg-gray-50 p-4 mac-shadow">
      <img src="/img/devicemirror-home.png" alt="DeviceMirror home" />
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-screen-xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {dict.devicemirror.features.map((feature) => (
        <div class="bg-white p-7 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <h3 class="text-lg font-bold mb-2.5 text-slate-900">{feature.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{feature.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="showcase" class="py-20 overflow-hidden">
    <div class="max-w-screen-xl mx-auto px-4">
      <div class="flex flex-col md:flex-row items-center gap-12 mb-20">
        <div class="w-full md:w-1/2">
          <div
            class="rounded-xl bg-gray-100 aspect-video flex items-center justify-center border border-gray-200 shadow-lg transform -rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <img src="/img/devicemirror-bigscreen.png" alt="DeviceMirror big screen" />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-bold mb-4 text-slate-900">{dict.devicemirror.showcase[0].title}</h3>
          <p class="text-lg text-slate-500 mb-6">{dict.devicemirror.showcase[0].body}</p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row-reverse items-center gap-12">
        <div class="w-full md:w-1/2">
          <div
            class="rounded-xl bg-gray-100 aspect-video flex items-center justify-center border border-gray-200 shadow-lg transform rotate-2 hover:rotate-0 transition-transform duration-500 overflow-hidden"
          >
            <img src="/img/devicemirror-record.png" alt="DeviceMirror recording" class="w-full h-full object-cover rounded-xl" />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-bold mb-4 text-slate-900">{dict.devicemirror.showcase[1].title}</h3>
          <p class="text-lg text-slate-500">{dict.devicemirror.showcase[1].body}</p>
        </div>
      </div>
    </div>
  </section>

  <Footer locale={locale} />
</SiteLayout>
