---
import SiteLayout from "../layouts/SiteLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getDictionary, getLangHref, DEFAULT_LOCALE } from "../i18n";

const { locale = DEFAULT_LOCALE, enableLangRedirect = false } = Astro.props;
const dict = getDictionary(locale);
const langHref = getLangHref(locale, "/aconverter.html");

const ldJson = locale === DEFAULT_LOCALE
  ? `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AConverter",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS",
        "description": "All-in-one local audio converter for Mac: NetEase/QQ music format conversion, universal video audio extraction, 8-thread batch concurrency, waveform ringtone trimmer, and audio merger",
        "url": "https://fineusing.com/aconverter.html",
        "image": "https://fineusing.com/img/aconverter-home.png",
        "screenshot": "https://fineusing.com/img/aconverter-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": [
            "QQ Music (.mflac, .mgg) and NetEase Cloud (.ncm) format conversion",
            "Extract audio from MP4, MOV, MKV, WebM and 9+ video formats",
            "Export to MP3, M4A, M4R, WAV, AIFF, FLAC, AC3, AAC, OGG, CAF, AMR, MP2",
            "Custom sample rate (8kHz-192kHz), bitrate (up to 320kbps/lossless), channels, and fade effects",
            "Batch conversion with up to 8 parallel tasks on Apple Silicon",
            "Waveform trimming and iPhone .m4r ringtone creation",
            "Sequential audio concatenation and merger",
            "100% offline local processing with zero cloud data upload"
        ]
    }`
  : locale === "ja"
  ? `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AConverter",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS",
        "description": "Mac専用の万能オーディオコンバーター：主要音楽配信フォーマット（NCM/MFLAC/MGG）変換、全形式動画からの音声抽出、8スレッド高速並行処理、波形トリミング着信音作成、複数ファイル結合",
        "url": "https://fineusing.com/ja/aconverter.html",
        "image": "https://fineusing.com/img/aconverter-home.png",
        "screenshot": "https://fineusing.com/img/aconverter-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "JPY"
        },
        "featureList": [
            "QQ音楽（.mflac, .mgg）および網易雲音楽（.ncm）形式の変換",
            "MP4, MOV, MKV, WebM など9種以上の動画から音声抽出",
            "MP3, M4A, M4R, WAV, AIFF, FLAC, AC3, AAC, OGG, CAF, AMR, MP2への書き出し",
            "サンプリングレート・ビットレート・チャンネル・フェードイン/アウト設定",
            "最大8スレッドの並行バッチ処理",
            "直感的な波形編集とiPhone専用着信音（.m4r）作成",
            "複数音声ファイルの順番通り結合・連結",
            "100%完全ローカル処理でプライバシー保護"
        ],
        "author": {
            "@type": "Organization",
            "name": "Fineusing"
        }
    }`
  : `{
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "AConverter",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "macOS",
        "description": "全能本地音频转换器：支持网易云/QQ音乐格式转换、全格式音视频提取、8 线程极速并发，纯本地运行，数秒转换一首歌",
        "url": "https://fineusing.com/cn/aconverter.html",
        "image": "https://fineusing.com/img/aconverter-home.png",
        "screenshot": "https://fineusing.com/img/aconverter-home.png",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "CNY"
        },
        "featureList": [
            "支持QQ音乐（.mflac, .mgg）与网易云音乐（.ncm）格式转换",
            "支持MP4、MOV、MKV、WebM等全格式视频秒级提取音频",
            "支持输出MP3、M4A、M4R、WAV、AIFF、FLAC、AC3、AAC、OGG、CAF、AMR、MP2等12种格式",
            "自由调节采样率、比特率、声道与淡入淡出",
            "支持最高8个并发任务同时批量转换",
            "内置音乐播放与毫秒级波形裁剪，轻松制作iPhone专属m4r铃声",
            "多音频顺序无缝拼接合并",
            "100%纯本地离线转换，零云端隐私上传"
        ],
        "author": {
            "@type": "Organization",
            "name": "Fineusing"
        }
    }`;

const canonical = locale === DEFAULT_LOCALE
  ? "https://fineusing.com/aconverter.html"
  : `https://fineusing.com/${locale}/aconverter.html`;
const ogUrl = canonical;
const altEn = "https://fineusing.com/aconverter.html";
const altZh = "https://fineusing.com/cn/aconverter.html";
const altJa = "https://fineusing.com/ja/aconverter.html";
const altTc = "https://fineusing.com/tc/aconverter.html";
const altFr = "https://fineusing.com/fr/aconverter.html";
const altDe = "https://fineusing.com/de/aconverter.html";
---
<SiteLayout lang={dict.langTag} enableLangRedirect={enableLangRedirect}>
  <Fragment slot="head">
    <title>
      {locale === DEFAULT_LOCALE
        ? "AConverter: All-in-One Local Audio Converter & Ringtone Maker for Mac"
        : locale === "ja"
        ? "AConverter: Mac専用万能オーディオコンバーター | 動画音声抽出＆着信音作成"
        : locale === "tc"
        ? "AConverter: 全能本機音訊轉換器 | 網易雲QQ格式轉換與影片提取音訊"
        : locale === "fr"
        ? "AConverter: Convertisseur audio tout-en-un & Créateur de sonneries pour Mac"
        : locale === "de"
        ? "AConverter: All-in-One Audiokonverter & Klingelton-Ersteller für Mac"
        : "AConverter: 全能本地音频转换器 | 网易云QQ格式转换与视频提取音频"}
    </title>
    <meta
      name="title"
      content={
        locale === DEFAULT_LOCALE
          ? "AConverter - Universal Audio Converter & Ringtone Trimmer for macOS"
          : locale === "ja"
          ? "AConverter - Mac専用万能オーディオ変換ツール＆着信音メーカー"
          : locale === "tc"
          ? "AConverter - 全能本機音訊轉換器：支援網易雲/QQ音樂格式轉換與全格式音視訊提取"
          : locale === "fr"
          ? "AConverter - Convertisseur audio universel pour Mac"
          : locale === "de"
          ? "AConverter - Universeller Audiokonverter für Mac"
          : "AConverter - 全能本地音频转换器：支持网易云/QQ音乐格式转换与全格式音视频提取"
      }
    />
    <meta
      name="description"
      content={
        locale === DEFAULT_LOCALE
          ? "Lossless audio converter for Mac. Convert NetEase NCM and QQ Music MFLAC/MGG, extract audio from videos, cut iPhone M4R ringtones, merge audio files, and batch process with up to 8 threads locally."
          : locale === "ja"
          ? "Mac専用の万能ローカル音声変換ツール。主要音楽形式（NCM/MFLAC/MGG）の変換、動画からの音声抽出、波形トリミングによるiPhone着信音作成、ファイル結合、最大8スレッド高速並行処理を完全ローカルで実現。"
          : locale === "tc"
          ? "AConverter 是一款 macOS 上的全能本機音訊轉換工具。支援網易雲（ncm）與 QQ 音樂（mflac/mgg）格式轉換、全格式音視訊提取純音訊、毫秒級波形裁剪自製 iPhone 鈴聲、多音訊順序拼接合併，全本機運算，單曲數秒即轉，支援最高 8 任務極速並行。"
          : locale === "fr"
          ? "Convertisseur audio hors-ligne pour Mac: conversion de formats, extraction audio depuis les vidéos, création de sonneries iPhone et traitement par lots 8 threads."
          : locale === "de"
          ? "Verlustfreier lokaler Audiokonverter für Mac: Audio aus Videos extrahieren, iPhone M4R-Klingeltöne schneiden und 8-Thread-Stapelverarbeitung."
          : "AConverter 是一款 macOS 上的全能本地音频转换工具。支持网易云（ncm）与 QQ 音乐（mflac/mgg）格式转换、全格式音视频提取纯音频、毫秒级波形裁剪自制 iPhone 铃声、多音频顺序拼接合并，全本地运算，单曲数秒即转，支持最高 8 任务极速并发。"
      }
    />
    <meta
      name="keywords"
      content={
        locale === DEFAULT_LOCALE
          ? "AConverter, audio converter mac, convert ncm to mp3, convert mflac to flac, extract audio from video mac, make m4r ringtone mac, batch audio converter, merge audio files mac, offline audio converter"
          : locale === "ja"
          ? "AConverter, Mac 音声変換, 音声フォーマット変換, ncm mp3 変換, mflac 変換, 動画から音声抽出 Mac, iPhone 着信音 作成 m4r, 音声結合 Mac, オフライン 音声変換"
          : locale === "tc"
          ? "AConverter, 音訊格式轉換, Mac音訊轉換器, ncm轉mp3, mflac轉flac, mgg格式轉換, 影片提取音訊, Mac製作iPhone鈴聲, m4r鈴聲製作, 音訊合併拼接, 本機批次音訊轉換"
          : locale === "fr"
          ? "AConverter, convertisseur audio mac, extraction audio video mac, sonnerie m4r mac, fusion audio mac, conversion audio hors ligne"
          : locale === "de"
          ? "AConverter, Audiokonverter Mac, Audio aus Video extrahieren Mac, M4R Klingelton Mac, Audio zusammenfügen Mac, Offline Audiokonverter"
          : "AConverter, 音频格式转换, Mac音频转换器, ncm转mp3, mflac转flac, mgg格式转换, 视频提取音频, Mac制作iPhone铃声, m4r铃声制作, 音频合并拼接, 本地批量音频转换"
      }
    />
    <meta name="author" content="Fineusing" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta
      property="og:title"
      content={
        locale === DEFAULT_LOCALE
          ? "AConverter: All-in-One Local Audio Converter & Ringtone Maker for Mac"
          : locale === "ja"
          ? "AConverter: Mac専用万能オーディオコンバーター"
          : locale === "tc"
          ? "AConverter: 全能本機音訊轉換器 | 格式轉換、影片提音與鈴聲裁剪"
          : locale === "fr"
          ? "AConverter: Convertisseur audio universel pour Mac"
          : locale === "de"
          ? "AConverter: Universeller Audiokonverter für Mac"
          : "AConverter: 全能本地音频转换器 | 格式转换、视频提音与铃声裁剪"
      }
    />
    <meta
      property="og:description"
      content={
        locale === DEFAULT_LOCALE
          ? "Convert proprietary streaming formats, extract audio from any video, trim ringtones, and batch process with 8 parallel tasks. 100% offline & private."
          : locale === "ja"
          ? "主要音楽形式変換、動画からの音声抽出、着信音作成、最大8スレッド並行バッチ処理を完全ローカルで。"
          : locale === "tc"
          ? "支援網易雲/QQ音樂格式轉換、全格式音視訊提取、8 執行緒極速並行，純本機運行，數秒轉換一首歌。"
          : locale === "fr"
          ? "Traitez vos fichiers audio en local, sans upload ni perte de qualité."
          : locale === "de"
          ? "Konvertieren Sie Streaming-Audioformate und extrahieren Sie Tonspuren lokal auf dem Mac."
          : "支持网易云/QQ音乐格式转换、全格式音视频提取、8 线程极速并发，纯本地运行，数秒转换一首歌。"
      }
    />
    <meta property="og:image" content="https://fineusing.com/img/aconverter-home.png" />
    <meta property="og:site_name" content="Fineusing" />
    <meta property="og:locale" content={dict.langTag} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="fineusing.com" />
    <meta property="twitter:url" content={ogUrl} />
    <meta
      name="twitter:title"
      content={
        locale === DEFAULT_LOCALE
          ? "AConverter: All-in-One Local Audio Converter for Mac"
          : locale === "ja"
          ? "AConverter: Mac専用万能オーディオコンバーター"
          : locale === "tc"
          ? "AConverter: 全能本機音訊轉換器"
          : locale === "fr"
          ? "AConverter: Convertisseur audio tout-en-un pour Mac"
          : locale === "de"
          ? "AConverter: Universeller Audiokonverter für Mac"
          : "AConverter: 全能本地音频转换器"
      }
    />
    <meta
      name="twitter:description"
      content={
        locale === DEFAULT_LOCALE
          ? "Fast, private, multi-threaded audio conversion and ringtone creation on macOS."
          : locale === "ja"
          ? "Mac専用の万能ローカル音声変換ツール。完全ローカルで安全かつ爆速。"
          : locale === "tc"
          ? "支援網易雲/QQ音樂格式轉換、全格式音視訊提取、8 執行緒極速並行，純本機運行，數秒轉換一首歌。"
          : locale === "fr"
          ? "Convertisseur audio local ultra-rapide et sécurisé pour macOS."
          : locale === "de"
          ? "Schnelle, private und lokale Audiokonvertierung auf macOS."
          : "支持网易云/QQ音乐格式转换、全格式音视频提取、8 线程极速并发，纯本地运行，数秒转换一首歌。"
      }
    />
    <meta name="twitter:image" content="https://fineusing.com/img/aconverter-home.png" />

    <!-- Alternate Links -->
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="zh-Hans" href={altZh} />
    <link rel="alternate" hreflang="ja" href={altJa} />
    <link rel="alternate" hreflang="zh-Hant" href={altTc} />
    <link rel="alternate" hreflang="fr" href={altFr} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="x-default" href={altEn} />

    <script type="application/ld+json" set:html={ldJson}></script>
  </Fragment>

  <Navbar locale={locale} active="products" langHref={langHref} />

  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-100/80 text-blue-700 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        {locale === "ja" ? "100% 完全ローカル処理・プライバシー保護" : locale === "tc" ? "100% 純本機極速離線運算 · 隱私零上傳" : locale === "cn" ? "100% 纯本地极速离线运算 · 隐私零上传" : "100% Offline Local Processing · Zero Cloud Upload"}
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-6">{dict.aconverter.title}</h1>
      <p class="text-xl text-slate-600 mb-10 max-w-3xl mx-auto leading-relaxed">{dict.aconverter.subtitle}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in-up delay-300">
        <a
          href={dict.aconverter.downloadUrl}
          target="_blank"
          rel="noopener noreferrer"
          id="download"
          class="w-full sm:w-auto px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg flex items-center justify-center gap-2"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.3-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.21-1.96 1.08-3.11-1.06.05-2.36.71-3.13 1.61-.65.77-1.22 2.01-1.07 3.11 1.2.09 2.4-.62 3.12-1.61"
            ></path>
          </svg>
          {dict.aconverter.cta}
        </a>
      </div>
    </div>
    <div class="mt-16 max-w-5xl mx-auto rounded-2xl border border-gray-200 bg-gray-50 p-4 mac-shadow overflow-hidden">
      <img src="/img/aconverter-home.png" alt="AConverter macOS main window" class="w-full h-auto rounded-xl shadow-inner" />
    </div>
  </section>

  <!-- 8 Core Features Grid -->
  <section class="py-20 bg-slate-50 border-y border-slate-100">
    <div class="max-w-screen-xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-3xl font-bold text-slate-900 mb-3">
          {locale === "ja" ? "Mac での音声処理を快適にする 8 大機能" : locale === "tc" ? "為 macOS 量身打造的 8 大全能音訊特性" : locale === "cn" ? "为 macOS 量身打造的 8 大全能音频特性" : "8 Core Pillars of Professional Audio Conversion on Mac"}
        </h2>
        <p class="text-slate-500 text-base">
          {locale === "ja" ? "音楽配信フォーマット変換から着信音作成、動画抽出、8スレッドバッチ処理まで完全網羅" : locale === "tc" ? "涵蓋音樂平台格式轉換、視訊一鍵抽離音訊、視覺化裁剪鈴聲與多任務並行" : locale === "cn" ? "涵盖音乐平台格式转换、视频一键提音、可视化裁剪铃声与多任务并发" : "Everything from streaming music format conversions to video soundtrack extraction, ringtone trims, and 8-thread batch processing."}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {dict.aconverter.features.map((feature, idx) => (
          <div class="bg-white p-7 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between hover:shadow-md transition-shadow group">
            <div>
              <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm mb-4 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                {String(idx + 1).padStart(2, '0')}
              </div>
              <h3 class="text-lg font-bold mb-2.5 text-slate-900">{feature.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{feature.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deep Showcase 1 & 2 -->
  <section id="showcase" class="py-24 overflow-hidden">
    <div class="max-w-screen-xl mx-auto px-4">
      <!-- Showcase 1 -->
      <div class="flex flex-col md:flex-row items-center gap-14 mb-24">
        <div class="w-full md:w-1/2">
          <div class="rounded-2xl bg-gray-100 aspect-video flex items-center justify-center border border-gray-200 shadow-xl transform -rotate-1 hover:rotate-0 transition-transform duration-500 overflow-hidden">
            <img src="/img/aconverter-waveform.png" alt="AConverter Waveform and Ringtone Trimmer" class="w-full h-full object-cover rounded-xl" />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <div class="inline-block px-3 py-1 rounded-md bg-indigo-50 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-4">
            {locale === "ja" ? "波形編集＆着信音" : locale === "tc" ? "波形裁剪 · 專屬鈴聲" : locale === "cn" ? "波形裁剪 · 专属铃声" : "Visual Waveform & Ringtone"}
          </div>
          <h3 class="text-3xl font-bold mb-4 text-slate-900">{dict.aconverter.showcase[0].title}</h3>
          <p class="text-lg text-slate-600 leading-relaxed mb-6">{dict.aconverter.showcase[0].body}</p>
          <ul class="space-y-3 text-slate-700 text-sm">
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              <span>{locale === "ja" ? "網易雲（.ncm）およびQQ音楽（.mflac/.mgg）の標準ファイル復元" : locale === "tc" ? "支援網易雲（.ncm）與 QQ 音樂（.mflac/.mgg）一鍵轉為標準 MP3/FLAC" : locale === "cn" ? "支持网易云（.ncm）与 QQ 音乐（.mflac/.mgg）一键转为标准 MP3/FLAC" : "Unlock NetEase (.ncm) and QQ Music (.mflac/.mgg) to standard audio"}
              </span>
            </li>
